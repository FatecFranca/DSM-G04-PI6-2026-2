{
  "name": "backend",
  "version": "1.0.0",
  "description": "API Backend Base",
  "main": "dist/app.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "worker:dev": "ts-node-dev --respawn --transpile-only src/workers/mensageria.ts",
    "worker:start": "node dist/src/workers/mensageria.js",
    "test": "npm run build && node --test dist/src/mensageria/mensageria.test.js dist/src/models/avaliacoes.integration.test.js dist/src/models/curtidasComentarios.integration.test.js",
    "test:integration": "npm run build && node --test --test-concurrency=1 dist/src/mensageria/persistencia.integration.test.js dist/src/mensageria/notificacoes.integration.test.js dist/src/models/avaliacoes.integration.test.js dist/src/mensageria/sugestoes.integration.test.js dist/src/models/curtidasComentarios.integration.test.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.3",
    "@google-cloud/pubsub": "^6.3.1",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "4.3.6"
  },
  "prisma": {
    "seed": "node ./node_modules/ts-node/dist/bin.js prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.30",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
