// Este arquivo descreve como os dados da aplicacao ficam organizados no banco.
// O Prisma usa este schema para gerar o cliente TypeScript e as migrations.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // A URL de conexao e lida da configuracao do Prisma/variaveis de ambiente.
  provider = "postgresql"
}

// Tipos de acao que um usuario pode realizar em um estabelecimento.
// Usar enum evita salvar valores diferentes para a mesma acao.
enum tipo_evento_interacao {
  view
  click
  favorite
  like
  dislike
  rating
  visitado
}

// Etapas possiveis do ciclo de vida de um modelo de recomendacao.
enum status_modelo_recomendacao {
  training
  ready
  archived
  failed
}

// Conta do usuario. Os campos terminados em [] representam listas relacionadas;
// elas nao viram colunas nesta tabela, mas permitem navegar pelas relacoes no Prisma.
model tb_usuario {
  id_usuario      Int                                    @id @default(autoincrement())
  url_imagem      String?
  nome            String
  email           String                                 @unique
  telefone        String?
  hash_senha      String
  ativo           Boolean                                @default(true)
  created_at      DateTime                               @default(now())
  updated_at      DateTime                               @updatedAt
  classificacoes  tb_classificacao[]
  interacoes      tb_interacao_usuario_estabelecimento[]
  features        tb_usuario_feature_snapshot[]
  recomendacoes   tb_recomendacao_cache[]
}

// Agrupa uma sessao/conjunto de avaliacoes feitas por um usuario.
model tb_classificacao {
  id_classificacao  Int                             @id @default(autoincrement())
  id_usuario        Int
  usuario           tb_usuario                      @relation(fields: [id_usuario], references: [id_usuario])
  created_at        DateTime                        @default(now())
  estabelecimentos  tb_classificacao_estabelecimento[]

  // Indice deixa mais rapida a busca das classificacoes de um usuario.
  @@index([id_usuario])
}

// Tabela de ligacao entre uma classificacao e um estabelecimento.
// Ela tambem guarda a nota e o comentario dados naquele momento.
model tb_classificacao_estabelecimento {
  id_classificacao   Int
  id_estabelecimento Int
  nota               Int?
  comentario         String?
  created_at         DateTime           @default(now())
  classificacao      tb_classificacao   @relation(fields: [id_classificacao], references: [id_classificacao])
  estabelecimento    tb_estabelecimento @relation(fields: [id_estabelecimento], references: [id_estabelecimento])

  // Chave composta: o mesmo estabelecimento aparece apenas uma vez em cada classificacao.
  @@id([id_classificacao, id_estabelecimento])
  @@index([id_estabelecimento])
}

// Local que pode ser mostrado e recomendado pelo aplicativo.
model tb_estabelecimento {
  id_estabelecimento  Int                              @id @default(autoincrement())
  nome                String
  tipo                String
  faixa_preco         String
  ambiente            String
  publico             String
  avaliacao           Decimal
  abre                String
  fecha               String
  latitude            Decimal?
  longitude           Decimal?
  cidade              String?
  bairro              String?
  // Json permite armazenar uma lista/estrutura de tags sem criar outra tabela.
  tags                Json?
  ativo               Boolean                          @default(true)
  created_at          DateTime                         @default(now())
  updated_at          DateTime                         @updatedAt
  classificacoes      tb_classificacao_estabelecimento[]
  interacoes          tb_interacao_usuario_estabelecimento[]

  @@index([tipo, faixa_preco, ambiente])
  @@index([cidade, bairro])
}

// Registra o comportamento do usuario. Esses eventos ajudam a aprender suas preferencias.
model tb_interacao_usuario_estabelecimento {
  id_interacao        Int                     @id @default(autoincrement())
  id_usuario          Int
  id_estabelecimento  Int
  tipo_evento         tipo_evento_interacao
  valor               Decimal?
  origem              String?
  regiao              String?
  created_at          DateTime                @default(now())
  usuario             tb_usuario              @relation(fields: [id_usuario], references: [id_usuario])
  estabelecimento     tb_estabelecimento      @relation(fields: [id_estabelecimento], references: [id_estabelecimento])

  @@index([id_usuario, created_at])
  @@index([id_estabelecimento, created_at])
  @@index([tipo_evento, created_at])
}

// "Fotografia" das preferencias calculadas para um usuario em certo momento.
// model_version identifica qual regra/modelo produziu os dados de feature_json.
model tb_usuario_feature_snapshot {
  id_snapshot   Int        @id @default(autoincrement())
  id_usuario    Int
  model_version String
  feature_json  Json
  created_at    DateTime   @default(now())
  usuario       tb_usuario @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_usuario, created_at])
  @@index([model_version])
}

// Metadados de cada versao do algoritmo de recomendacao treinado.
model tb_modelo_recomendacao {
  id_modelo     Int                        @id @default(autoincrement())
  versao        String                     @unique
  algoritmo     String
  metricas_json Json?
  storage_uri   String?
  status        status_modelo_recomendacao @default(training)
  trained_at    DateTime?
  created_at    DateTime                   @default(now())
  recomendacoes tb_recomendacao_cache[]
}

// Guarda temporariamente um ranking pronto para evitar recalcular a mesma recomendacao.
model tb_recomendacao_cache {
  id_usuario    Int
  model_version String
  context_hash  String
  ranking_json  Json
  expires_at    DateTime
  created_at    DateTime               @default(now())
  usuario       tb_usuario             @relation(fields: [id_usuario], references: [id_usuario])
  modelo        tb_modelo_recomendacao @relation(fields: [model_version], references: [versao])

  // A combinacao abaixo identifica um cache para um usuario, modelo e filtros especificos.
  @@id([id_usuario, model_version, context_hash])
  @@index([expires_at])
}


// Eventos gravados na mesma transacao da interacao; o worker publica depois.
model tb_evento_outbox {
  id_evento             String    @id
  conteudo              Json
  criado_em             DateTime  @default(now())
  publicado_em          DateTime?
  id_mensagem           String?
  tentativas            Int       @default(0)
  proxima_tentativa_em   DateTime  @default(now())

  @@index([publicado_em, proxima_tentativa_em])
}

model tb_evento_processado {
  id_evento       String   @id
  processado_em   DateTime @default(now())
}

// Mensagens invalidas ficam disponiveis para investigacao, sem loop de entrega.
model tb_mensagem_quarentena {
  chave         String   @id
  id_mensagem   String
  conteudo      Bytes
  motivo        String
  criado_em     DateTime @default(now())
}
